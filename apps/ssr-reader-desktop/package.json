{
    "name":  "ssr-reader-desktop",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Independent local-only Vietnamese novel reader for Windows; does not contain SSR Writer",
    "main":  "main.cjs",
    "license":  "GPL-3.0-only",
    "scripts":  {
                    "start":  "electron .",
                    "test":  "node --test tests/*.test.cjs",
                    "build:windows":  "electron-builder --win dir --x64 --publish never",
                    "test:e2e":  "node tests/reader-e2e.cjs"
                },
    "devDependencies":  {
                            "electron":  "^41.10.3",
                            "electron-builder":  "^26.15.0",
                            "playwright":  "^1.59.1"
                        },
    "build":  {
                  "appId":  "com.ssr.reader.desktop",
                  "productName":  "SSR Reader",
                  "asar":  true,
                  "directories":  {
                                      "output":  "../../.runtime/ssr-reader-build"
                                  },
                  "files":  [
                                "package.json",
                                "main.cjs",
                                "preload.cjs",
                                "reader-core.cjs",
                                "reader.js",
                                "index.html",
                                "styles.css"
                            ],
                  "win":  {
                              "target":  [
                                             "dir"
                                         ]
                          },
                  "artifactName":  "SSR-Reader-${version}-${arch}.${ext}"
              }
}
